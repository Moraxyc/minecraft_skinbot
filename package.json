{
  "name": "minecraft-skinbot",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.21.0 <25"
  },
  "scripts": {
    "check": "node scripts/check-runtime.mjs",
    "check:static": "node scripts/check-runtime.mjs --static",
    "test": "node --experimental-test-module-mocks --experimental-vm-modules --import ./scripts/register-sdk-mock.mjs --test tests/serverless/*.test.js",
    "verify": "npm run check && npm test",
    "build:web": "npm --prefix web run build",
    "build:skin-png": "node scripts/build-skin-png.mjs",
    "push": "rm -r web/dist && npm run build:web && tgcloud migrate && tgcloud push"
  },
  "devDependencies": {
    "@tgcloud/cli": "0.2.0",
    "acorn": "8.15.0",
    "ajv": "8.18.0",
    "esbuild": "0.25.12",
    "fast-png": "8.0.0",
    "fflate": "0.8.3",
    "iobuffer": "6.0.1",
    "jsonc-parser": "3.3.1",
    "pako": "2.1.0",
    "pngjs": "7.0.0"
  }
}
