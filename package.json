{
  "name": "minecraft-skinbot",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.21.0 <25"
  },
  "scripts": {
    "check": "node scripts/check-runtime.mjs",
    "check:static": "node scripts/check-runtime.mjs --static",
    "test": "node --experimental-test-module-mocks --import ./scripts/register-sdk-mock.mjs --test tests/serverless/*.test.js",
    "verify": "npm run check && npm test",
    "build:web": "npm --prefix web run build"
  },
  "devDependencies": {
    "@tgcloud/cli": "0.2.0",
    "acorn": "8.15.0",
    "ajv": "8.17.1",
    "jsonc-parser": "3.3.1"
  }
}
